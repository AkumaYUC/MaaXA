{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaXA",
    "description": "金蝶云自动化办公助手：Excel 调拨单自动录入金蝶云星空。",
    "contact": "AkumaYUC#0001",
    "license": "GPL-3.0",
    "welcome": "欢迎使用 MAAXA!目前程序还在开发阶段，可能会有各种各样的bug或者需要优化的流程，如有问题请联系开发者。",

    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/AkumaYUC/MaaXA",
    "version": "1.0.1",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXA",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "金蝶|云星空|Kingdee.BOS.XPF",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "ScreenDC", // 截图方式（原PrintWindow）
                "mouse": "Seize", // 鼠标控制方式(原：PostMessageWithCursorPos)
                "keyboard": "Seize" // 键盘控制方式（原：PostMessageWithCursorPos）
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],

    // Windows-only：在 Maa Controller 创建前确保金蝶云已启动。
    // 脚本会复用已有的金蝶窗口或进程，不会重复启动；不要同时启用 Avalonia 的“启动游戏”。
    // 金蝶安装路径由脚本自动探测（遍历各盘 Program Files），无需在这里配置。
    "pretask": {
        "name": "启动金蝶云",
        "label": "启动金蝶云",
        "description": "已有金蝶云窗口或进程时跳过启动；没有时自动启动并等待窗口就绪。",
        "controller": [
            "桌面端"
        ],
        "exec": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
        "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "../../agent/start_kingdee.ps1",
            "-WindowRegex",
            "金蝶|云星空|Kingdee.BOS.XPF",
            "-WaitSeconds",
            "60"
        ]
    },

    // Maa AgentServer：只负责已连接 Controller 后的自定义识别和动作。
    "agent": {
        "child_exec": "E:/MAAFWStudy/MAAXA/.venv/Scripts/python.exe",
        "child_args": [
            "-u",
            "E:/MAAFWStudy/MAAXA/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "直接调拨单",
            "entry": "拉回金蝶云",
            "option": [
                "单据文件"
            ]
        }
    ],
    "option": {
        "单据文件": {
            "type": "file",
            "label": "单据文件",
            "description": "拖入 Excel 调拨单，任务全部成功后自动归档副本。表格格式：物料编码、数量、调出仓库、调出仓位、调入仓库、调入仓位、调出库存组织、调入库存组织、备注。两个组织填在整单第一行即可；同一张单里填代码还是填名称请统一。",
            "inputs": [
                {
                    "name": "单据文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "读取Excel数据": {
                    "custom_action_param": { "path": "{单据文件}" }
                }
            }
        }
    }
}