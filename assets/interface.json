{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaXA",
    "description": "金蝶云自动化办公助手：Excel 调拨单自动录入金蝶云星空。",
    "contact": "https://github.com/AkumaYUC/MaaXA/issues",
    "license": "GPL-3.0",
    "welcome": [
        {
            "label": "欢迎",
            "content": "欢迎使用 MAAXA！\n\n目前程序还在开发阶段，可能会有各种各样的 bug 或者需要优化的流程。\n\n如有问题请联系开发者或者提交 issue，请务必带上日志以及问题描述。\n\n<img src=\"image/公告日志导出.png\" width=\"48%\" alt=\"日志在此导出\" />"
        },
        {
            "label":"更新日志",
            "content":"1.0.5 直接调拨单任务：\n\n1. 粘贴后弹出的「粘贴异常」窗口现在能自动识别、自动关闭，并把被弹窗吃掉的那次粘贴自动补回去（旧版靠截图模板识别，因显示缩放问题从未生效过）。\n2. 修复调入仓库反复重填不停的问题：填写校验看错了列，导致整段流程原地循环。\n3. 调拨单整体动作流程优化。\n\nExcel 填法与上一版相同：仓库与库存组织填在每张单首行；同一张单里填代码还是填名称请统一。"
        }
    ],

    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/AkumaYUC/MaaXA",
    "version": "1.0.5",

    "controller": [
        {
            // 网页端占位连接：Web* 动作全部经 CDP(9333) 直驱页面，不用这里的截图/键鼠；
            // MAA 框架要求任务必须有已连接控制器，这里给一个永不误伤前台的配置（绝不 Seize）。
            // class_regex 用 Chrome_WidgetWin_1 精确命中 Edge/Chrome 窗口，与金蝶客户端 HwndWrapper[...] 天然区分
            // ⚠️排第一：MFAAvalonia 启动时不恢复上次选择，控制器下拉默认取数组首项（2026-11-24 实测）
            "name": "网页端",
            "type": "Win32",
            "win32": {
                "class_regex": "Chrome_WidgetWin_1",
                "window_regex": "金蝶云星空|K3Cloud",
                "screencap": "FramePool",
                "mouse": "PostMessage",
                "keyboard": "PostMessage"
            }
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "金蝶|云星空|Kingdee.BOS.XPF",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "FramePool", // 截图方式（原ScreenDC）
                "mouse": "Seize", // 鼠标控制方式(原：PostMessageWithCursorPos)
                "keyboard": "PostMessage" // 键盘控制方式（原：Seize）
            }
        }
    ],
    "resource": [
        {
            "name": "网页",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "程序页",
            "path": [
                "./resource"
            ]
        }
    ],

    // 2026-11-24 用户口径：不自动拉起【金蝶桌面客户端】（原 start_kingdee.ps1 pretask 已删，
    // 要自启请在 GUI 设置→启动设置→应用路径 自行配置）。
    // 下面这条只拉起【专用调试 Edge】（独立 profile + CDP 端口，网页端自动化的命脉；
    // 用户手开的普通 Edge 没有调试端口，CDP 连不上）。脚本幂等：端口已活秒退，不重复开窗。
    // controller 过滤 = 仅选中「网页端」控制器时执行（PI v2.8.1）；单对象写法（2.14 数组会被静默跳过）
    // ⚠️MFAAvalonia 的 pretask 实际 CWD 不是 interface.json 所在目录（11-25 实测：写
    //   agent/start_web.ps1 报 exited with code -196608=文件找不到；桌面端 ../../agent/ 一直是通的）
    //   → 改用 -Command 在三个候选相对位置里探测脚本，与启动目录无关。
    // 「连接」按钮和「启动任务」都会跑 pretask（11-23 日志 src=UI op=RefreshDevices 实证）
    //   → 误关 Edge 后点一下「连接」就自动重开，这就是用户要的"打开 web 端"入口（11-25 拍板）。
    "pretask": {
        "name": "启动网页Edge",
        "label": "启动网页Edge",
        "description": "拉起带 CDP 调试端口的专用 Edge（独立 profile，登录态持久化）；端口已活则跳过，K3Cloud 页签被关会自动补开。",
        "controller": [
            "网页端"
        ],
        "exec": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
        "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "$p = 'agent/start_web.ps1','../../agent/start_web.ps1','../../../agent/start_web.ps1' | Where-Object { Test-Path $_ } | Select-Object -First 1; if ($p) { & $p -Port 9333 -WaitSeconds 40; exit $LASTEXITCODE } else { Write-Error ('start_web.ps1 not found from CWD ' + (Get-Location)); exit 4 }"
        ]
    },

    // Maa AgentServer：只负责已连接 Controller 后的自定义识别和动作。
    "agent": {
        "child_exec": "python/python.exe",
        "child_args": [
            "-u",
            "agent/main.py"
        ]
    },
    "task": [
        {
            "name": "调拨申请单(网页端)",
            "entry": "TransferRequisitionFormEntryWeb",
            "resource": [
                "网页"
            ],
            "option": [
                "调拨申请单文件(网页)"
            ]
        },
        {
            "name": "直接调拨单",
            "entry": "直接调拨单任务入口",
            "resource": [
                "程序页"
            ],
            "option": [
                "单据文件"
            ]
        },
        {
            "name": "调拨申请单",
            "entry": "TransferRequisitionFormEntry",
            "resource": [
                "程序页"
            ],
            "option": [
                "调拨申请单文件"
            ]
        },
        {
            "name":"即时库存导出",
            "entry":"ExportInventoryDataEntry",
            "resource": [
                "程序页"
            ]
        }
    ],
    "option": {
        "单据文件": {
            "type": "file",
            "label": "单据文件",
            "description": "Excel 列：物料编码、数量、调出仓库、调出仓位、调入仓库、调入仓位、调出库存组织、调入库存组织、备注。两个组织与备注填首行即可，仓库列必填；组织填代码或名称，同一张单统一写法。",
            "template":"template/直接调拨单模版.xlsx",
            "inputs": [
                {
                    "name": "单据文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "读取Excel数据": {
                    "custom_action_param": { "path": "{单据文件}" }
                }
            }
        },
        "调拨申请单文件": {
            "type": "file",
            "label": "调拨申请单文件",
            "description": "Excel 列：物料编码、数量、调出组织、调出仓库、调出仓位、调入组织、调入仓库、调入仓位、申请组织、调拨类型、调拨申请类型、申请人、联系电话、通讯地址、联系人、需求日期（当天）。调拨类型只能填「组织内调拨」或「跨组织调拨」；申请组织/调拨类型/申请人等整单字段填首行即可；需求日期留空按当天。",
            "template":"template/调拨申请单模版.xlsx",
            "inputs": [
                {
                    "name": "调拨申请单文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "TransferRequisitionFormReadExcel": {
                    "custom_action_param": { "path": "{调拨申请单文件}", "template": "requisition" }
                }
            }
        },
        "调拨申请单文件(网页)": {
            "type": "file",
            "label": "调拨申请单文件(网页)",
            "description": "Excel 列与「调拨申请单文件」完全一致（同一张模板可直接用）。区别只在执行方式：经 Edge 调试端口驱动金蝶云网页端，不抢前台、不动鼠标键盘。",
            "template":"template/调拨申请单模版.xlsx",
            "inputs": [
                {
                    "name": "调拨申请单文件(网页)",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "TransferRequisitionFormReadExcelWeb": {
                    "custom_action_param": { "path": "{调拨申请单文件(网页)}", "template": "requisition" }
                }
            }
        }
    }
}