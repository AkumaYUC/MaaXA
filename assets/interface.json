{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaXA",
    "description": "金蝶云自动化办公助手：Excel 调拨单自动录入金蝶云星空。",
    "contact": "https://github.com/AkumaYUC/MaaXA/issues",
    "license": "GPL-3.0",
    "welcome": [
        {
            "label": "欢迎",
            "content": "欢迎使用 MAAXA！\n\n目前程序还在开发阶段，可能会有各种各样的 bug 或者需要优化的流程。\n\n如有问题请联系开发者或者提交 issue，请务必带上日志以及问题描述。\n\n<img src=\"image/公告日志导出.png\" width=\"48%\" alt=\"日志在此导出\" />"
        },
        {
            "label":"更新日志",
            "content":"1.0.4 直接调拨单任务：\n\n1. 仓位可以空着不填了：单据没有调出/调入仓位时，Excel 里那一列空着就行，程序会自动跳过仓位填写。\n2. 不用逐行批量填充了：调出/调入仓库、仓位以及备注，一张单只填在第一个物料行即可，其余行留空。\n3. 新增填表模版：不知道怎么填的，按模版字段匹配填写，每张单据之间空一行作为分隔。\n\n注意：仓库与库存组织仍需在每张单的首行填写；同一张单里填代码还是填名称请统一。"
        }
    ],

    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/AkumaYUC/MaaXA",
    "version": "1.0.4",

    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "金蝶|云星空|Kingdee.BOS.XPF",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "ScreenDC", // 截图方式（原PrintWindow）
                "mouse": "Seize", // 鼠标控制方式(原：PostMessageWithCursorPos)
                "keyboard": "Seize" // 键盘控制方式（原：PostMessageWithCursorPos）
            }
        }
    ],
    "resource": [
        {
            "name": "程序页",
            "path": [
                "./resource"
            ]
        }
    ],

    // Windows-only：在 Maa Controller 创建前确保金蝶云已启动。
    // 脚本会复用已有的金蝶窗口或进程，不会重复启动；不要同时启用 Avalonia 的“启动游戏”。
    // 金蝶安装路径由脚本自动探测（遍历各盘 Program Files），无需在这里配置。
    "pretask": {
        "name": "启动金蝶云",
        "label": "启动金蝶云",
        "description": "已有金蝶云窗口或进程时跳过启动；没有时自动启动并等待窗口就绪。",
        "controller": [
            "桌面端"
        ],
        "exec": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
        "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "../../agent/start_kingdee.ps1",
            "-WindowRegex",
            "金蝶|云星空|Kingdee.BOS.XPF",
            "-WaitSeconds",
            "60"
        ]
    },

    // Maa AgentServer：只负责已连接 Controller 后的自定义识别和动作。
    "agent": {
        "child_exec": "python/python.exe",
        "child_args": [
            "-u",
            "agent/main.py"
        ]
    },
    "task": [
        {
            "name": "直接调拨单",
            "entry": "直接调拨单任务入口",
            "option": [
                "单据文件"
            ]
        },
        {
            "name":"即时库存导出",
            "entry":"ExportInventoryDataEntry"
        }
    ],
    "option": {
        "单据文件": {
            "type": "file",
            "label": "单据文件",
            "description": "拖入 Excel 调拨单，任务全部成功后自动归档副本。表格格式：物料编码、数量、调出仓库、调出仓位、调入仓库、调入仓位、调出库存组织、调入库存组织、备注。两个组织填在整单第一行即可；同一张单里填代码还是填名称请统一。",
            "template":"template/直接调拨单模版.xlsx",
            "inputs": [
                {
                    "name": "单据文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "读取Excel数据": {
                    "custom_action_param": { "path": "{单据文件}" }
                }
            }
        }
    }
}