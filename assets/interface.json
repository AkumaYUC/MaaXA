{
    // 项目接口定义：声明控制器、资源、任务与运行时选项。
    // 协议文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaXA",
    "description": "金蝶云星空（ERP）自动化助手：Excel 单据批量录入、提交、下推、库存导出等全流程自动化。",
    "contact": "https://github.com/AkumaYUC/MaaXA/issues",
    "license": "GPL-3.0",
    "welcome": [
        {
            "label": "欢迎",
            "content": "欢迎使用 MaaXA。\n\n目前程序还在完善开发阶段，如果您遇到任何问题请联系我或者在 Github 上提交 issue，请务必带上日志以及问题描述。\n\n推荐连接方式：\n捕获方式：FramePool\n鼠标输入：PostMessage\n键盘输入：PostMessage\n\n网页端程序需要特定浏览器打开才能执行，一般打开本程序就会自动打开该浏览器，如果没有，请点击「开始任务」旁的重新连接，程序会自动重新打开浏览器。\n\n<img src=\"image/公告日志导出.png\" width=\"48%\" alt=\"日志在此导出\" />"
        },
        {
            "label": "更新日志",
            "content": "## 1.0.6\n\n1. **新增金蝶云网页端后台执行**：调拨申请单可直接驱动金蝶云网页端，全程不抢前台、不动鼠标键盘，您可以一边跑任务一边干别的。\n2. **新增调拨申请单任务**：桌面端、网页端两条链路均可用；网页端可选开关「是否提交并下推单据」——开启后每张单填完自动提交→审核→下推，关闭则只填写不提交（默认）。\n3. 优化了代码逻辑，使任务执行更加高效。\n4. 修复偶发出现执行操作失误的现象。\n\n## 1.0.5\n\n**直接调拨单任务**\n\n1. **粘贴异常弹窗能自动处理了**：粘贴后概率弹出的「粘贴异常」窗口，现在会被自动识别、自动关闭，并把被弹窗吃掉的那次粘贴自动补回去（旧版这个处理写了但从未生效过——识别模板与程序截图的显示缩放不一致，永远匹配不上）。\n2. **修复调入仓库反复重填不停**：填写校验的识别区域看错了列，导致整段流程原地循环重填。\n3. 调拨单整体动作流程优化。\n\n## 1.0.4\n\n**直接调拨单任务**\n\n1. **仓位可以空着不填了**：优化了仓位输入逻辑，单据没有调出/调入仓位时，Excel 里那一列空着就行，程序会自动跳过仓位填写。\n2. **不用逐行批量填充了**：调出/调入仓库、仓位以及备注，一张单只填在第一个物料行即可，其余行留空。\n3. **新增填表模版**：不知道怎么填的，按模版字段匹配填写，每张单据之间空一行作为分隔。\n\n> 注意：仓库与库存组织仍需在每张单的首行填写；同一张单里填代码还是填名称请统一。"
        }
    ],

    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/AkumaYUC/MaaXA",
    "version": "1.0.6",

    "controller": [
        {
            // 网页端占位连接：Web 动作全部经 CDP(9333) 直驱页面，不用这里的截图/键鼠；
            // MAA 框架要求任务必须有已连接控制器，这里给一个永不误伤前台的配置（绝不 Seize）。
            "name": "网页端",
            "type": "Win32",
            "win32": {
                "class_regex": "Chrome_WidgetWin_1",
                "window_regex": "金蝶云星空|K3Cloud",
                "screencap": "FramePool",
                "mouse": "PostMessage",
                "keyboard": "PostMessage"
            }
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "金蝶|云星空|Kingdee.BOS.XPF",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "PostMessage"
            }
        }
    ],
    "resource": [
        {
            "name": "网页",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "程序页",
            "path": [
                "./resource"
            ]
        }
    ],

    // 只拉起【专用调试 Edge】（独立 profile + CDP 端口）：网页端自动化依赖该调试端口，
    // 用户手开的普通 Edge 没有调试端口，CDP 连不上。脚本幂等，端口已活则跳过。
    // controller 过滤 = 仅选中「网页端」控制器时执行。
    // pretask 在「连接」和「启动任务」时都会执行，因此误关 Edge 后可从此处重开。
    "pretask": {
        "name": "启动网页Edge",
        "label": "启动网页Edge",
        "description": "拉起带 CDP 调试端口的专用 Edge（独立 profile，登录态持久化）；端口已活则跳过，K3Cloud 页签被关会自动补开。",
        "controller": [
            "网页端"
        ],
        "exec": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
        "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "$p = 'agent/start_web.ps1','../../agent/start_web.ps1','../../../agent/start_web.ps1' | Where-Object { Test-Path $_ } | Select-Object -First 1; if ($p) { & $p -Port 9333 -WaitSeconds 40; exit $LASTEXITCODE } else { Write-Error ('start_web.ps1 not found from CWD ' + (Get-Location)); exit 4 }"
        ]
    },

    // Maa AgentServer：只负责已连接 Controller 后的自定义识别和动作。
    "agent": {
        "child_exec": "python/python.exe",
        "child_args": [
            "-u",
            "agent/main.py"
        ]
    },
    "task": [
        {
            "name": "调拨申请单(网页端)",
            "entry": "TransferRequisitionFormEntryWeb",
            "description": "**注意！！！**\n\n请在表中核对字段信息准确性。\n\n除物料编码以及数量等不一的字段需要全部填入外，其他字段只填入第一行即可。\n\n默认在 Excel 中空一行为一张单。\n\n该任务打开「是否提交并下推单据」后，会直接将单据下推分布式调拨单，请明确自身需求选择性开启。",
            "resource": [
                "网页"
            ],
            "option": [
                "调拨申请单文件(网页)",
                "是否提交并下推单据"
            ]
        },
        {
            "name": "直接调拨单(网页端)",
            "entry": "TransferOrderWebEntry",
            "description": "**注意！！！**\n\n请在表中核对字段信息准确性。\n\n物料编码与数量逐行填；调出/调入库存组织、调拨类型、备注只填首行即可。\n\n默认在 Excel 中空一行为一张单。\n\n该任务关闭「是否提交（直接调拨单）」时只填写不提交，跑完留未保存页签手动关（默认，测试行为）；打开后每张单填完自动提交，真单进 ERP 工作流。",
            "resource": [
                "网页"
            ],
            "option": [
                "直接调拨单文件(网页)",
                "是否提交（直接调拨单）"
            ]
        },
        {
            "name": "直接调拨单",
            "entry": "直接调拨单任务入口",
            "resource": [
                "程序页"
            ],
            "option": [
                "单据文件"
            ]
        },
        {
            "name": "调拨申请单",
            "entry": "TransferRequisitionFormEntry",
            "resource": [
                "程序页"
            ],
            "option": [
                "调拨申请单文件"
            ]
        },
        {
            "name":"即时库存导出",
            "entry":"ExportInventoryDataEntry",
            "resource": [
                "程序页"
            ]
        }
    ],
    "option": {
        "单据文件": {
            "type": "file",
            "label": "单据文件",
            "description": "Excel 列：物料编码、数量、调出仓库、调出仓位、调入仓库、调入仓位、调出库存组织、调入库存组织、调拨类型、备注。两个组织、调拨类型与备注填首行即可，仓库列必填；组织填代码或名称，同一张单统一写法。调拨类型只能填「组织内调拨」或「跨组织调拨」，留空则按两个组织是否相同自动判断（旧模版没有这列也能直接跑）。",
            "template":"template/直接调拨单模版.xlsx",
            "inputs": [
                {
                    "name": "单据文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "读取Excel数据": {
                    "custom_action_param": { "path": "{单据文件}" }
                }
            }
        },
        "调拨申请单文件": {
            "type": "file",
            "label": "调拨申请单文件",
            "description": "Excel 列：物料编码、数量、调出组织、调出仓库、调出仓位、调入组织、调入仓库、调入仓位、申请组织、调拨类型、调拨申请类型、申请人、联系电话、通讯地址、联系人、需求日期（当天）。调拨类型只能填「组织内调拨」或「跨组织调拨」；申请组织/调拨类型/申请人等整单字段填首行即可；需求日期留空按当天。",
            "template":"template/调拨申请单模版.xlsx",
            "inputs": [
                {
                    "name": "调拨申请单文件",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "TransferRequisitionFormReadExcel": {
                    "custom_action_param": { "path": "{调拨申请单文件}", "template": "requisition" }
                }
            }
        },
        "调拨申请单文件(网页)": {
            "type": "file",
            "label": "调拨申请单文件(网页)",
            "description": "Excel 列与「调拨申请单文件」完全一致（同一张模板可直接用）。区别只在执行方式：经 Edge 调试端口驱动金蝶云网页端，不抢前台、不动鼠标键盘。",
            "template":"template/调拨申请单模版.xlsx",
            "inputs": [
                {
                    "name": "调拨申请单文件(网页)",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "TransferRequisitionFormReadExcelWeb": {
                    "custom_action_param": { "path": "{调拨申请单文件(网页)}", "template": "requisition" }
                }
            }
        },
        "是否提交并下推单据": {
            "type": "switch",
            "label": "是否提交并下推单据",
            "description": "开：每张单填完自动 提交→审核→下推（真单进 ERP 工作流，审核后不可逆，确认是真实单据再开）。关：只填写不提交，跑完留未保存页签手动关（默认，测试行为）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TransferRequisitionFormFillLocInWeb": {
                            "next": [
                                "TransferRequisitionFormSubmitWeb"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TransferRequisitionFormFillLocInWeb": {
                            "next": [
                                "TransferRequisitionFormNewBillWeb"
                            ]
                        }
                    }
                }
            ]
        },
        "直接调拨单文件(网页)": {
            "type": "file",
            "label": "直接调拨单文件(网页)",
            "description": "Excel 列：物料编码、数量、调出仓库、调出仓位、调入仓库、调入仓位、调出库存组织、调入库存组织、调拨类型、备注。调出/调入库存组织、调拨类型与备注填首行即可，仓库列必填；组织填代码或名称，同一张单统一写法。调拨类型留空则按两个组织是否相同自动判断。区别只在执行方式：经 Edge 调试端口驱动金蝶云网页端，不抢前台、不动鼠标键盘。",
            "template": "template/直接调拨单模版.xlsx",
            "inputs": [
                {
                    "name": "直接调拨单文件(网页)",
                    "label": "拖拽 Excel 文件到此，或点击浏览选择文件",
                    "description": "浏览",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "TransferOrderWebReadExcel": {
                    "custom_action_param": { "path": "{直接调拨单文件(网页)}", "template": "transfer" }
                }
            }
        },
        "是否提交（直接调拨单）": {
            "type": "switch",
            "label": "是否提交（直接调拨单）",
            "description": "开：每张单填完自动提交（真单进 ERP 工作流，提交后不可逆，确认是真实单据再开）。关：只填写不提交，跑完留未保存页签手动关（默认，测试行为）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TransferOrderWebFillLocIn": {
                            "next": [
                                "TransferOrderWebSubmit"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TransferOrderWebFillLocIn": {
                            "next": [
                                "TransferOrderWebNewBill"
                            ]
                        }
                    }
                }
            ]
        }
    }
}