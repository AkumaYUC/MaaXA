{
    "TransferOrderWebEntry": {
        "desc": "直接调拨单(网页端)任务入口",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferOrderWebSetForm"
        ]
    },
    "TransferOrderWebSetForm": {
        "desc": "切换网页端单据为直接调拨单（明细实体 FBILLENTRY + 字段表）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebSetForm",
        "custom_action_param": {
            "form": "transfer"
        },
        "next": [
            "TransferOrderWebReadExcel"
        ]
    },
    "TransferOrderWebReadExcel": {
        "desc": "读取直接调拨单Excel文件字段数据",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "ReadTransferExcel",
        "custom_action_param": {
            "path": "",
            "template": "transfer"
        },
        "next": [
            "TransferOrderWebNavigate"
        ]
    },
    "TransferOrderWebNavigate": {
        "desc": "后台导航直达直接调拨单新增页签",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebNavigate",
        "custom_action_param": {
            "text": "直接调拨单列表",
            "wait_label": "调出库存组织",
            "timeout_ms": 60000
        },
        "next": [
            "TransferOrderWebNextOrder"
        ],
        "on_error": [
            "TransferOrderWebNavigate"
        ]
    },
    "TransferOrderWebNextOrder": {
        "desc": "直接调拨单下一张单的数据录入节点",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "NextOrder",
        "next": [
            "TransferOrderWebSourceOrg"
        ],
        "on_error": [
            "TransferOrderWebDone"
        ]
    },
    "TransferOrderWebSourceOrg": {
        "desc": "调出库存组织填写（单头基础资料）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebSetHeaderField",
        "custom_action_param": {
            "field": "source_org"
        },
        "next": [
            "TransferOrderWebTargetOrg"
        ]
    },
    "TransferOrderWebTargetOrg": {
        "desc": "调入库存组织填写（单头基础资料）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebSetHeaderField",
        "custom_action_param": {
            "field": "target_org"
        },
        "next": [
            "TransferOrderWebTransferType"
        ]
    },
    "TransferOrderWebTransferType": {
        "desc": "调拨类型下拉选择（Excel填了用填的，留空按组织推导）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebPickCombo",
        "custom_action_param": {
            "field": "transfer_type"
        },
        "next": [
            "TransferOrderWebRemark"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebRemark": {
        "desc": "单头备注填写",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebSetHeaderField",
        "custom_action_param": {
            "field": "remark"
        },
        "next": [
            "TransferOrderWebFillMaterial"
        ]
    },
    "TransferOrderWebFillMaterial": {
        "desc": "物料编码整列块粘贴（右键块粘贴→灌整列→确定）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebBlockPaste",
        "custom_action_param": {
            "field": "material_code"
        },
        "next": [
            "TransferOrderWebFillQty"
        ]
    },
    "TransferOrderWebFillQty": {
        "desc": "调拨数量整列块粘贴",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebBlockPaste",
        "custom_action_param": {
            "field": "quantity"
        },
        "next": [
            "TransferOrderWebCheckRows"
        ]
    },
    "TransferOrderWebCheckRows": {
        "desc": "ERP界面行数与Excel行数对账",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": "Custom",
        "custom_recognition": "WebRowCount",
        "custom_recognition_param": {
            "field": "material_code"
        },
        "next": [
            "TransferOrderWebFillWhOut"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebFillWhOut": {
        "desc": "调出仓库整列铺开（批量填充；同时解锁调出仓位）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebPatchFill",
        "custom_action_param": {
            "field": "source_warehouse"
        },
        "next": [
            "TransferOrderWebFillLocOut"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebFillLocOut": {
        "desc": "调出仓位整列铺开（弹性域；Excel留空则跳过）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebPatchFill",
        "custom_action_param": {
            "field": "source_location"
        },
        "next": [
            "TransferOrderWebFillWhIn"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebFillWhIn": {
        "desc": "调入仓库整列铺开（批量填充；同时解锁调入仓位）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebPatchFill",
        "custom_action_param": {
            "field": "target_warehouse"
        },
        "next": [
            "TransferOrderWebFillLocIn"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebFillLocIn": {
        "desc": "调入仓位整列铺开（弹性域；Excel留空则跳过）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebPatchFill",
        "custom_action_param": {
            "field": "target_location"
        },
        "next": [
            "TransferOrderWebNewBill"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebSubmit": {
        "desc": "顶栏提交：由任务开关「是否提交（直接调拨单）」接入（Yes 时 FillLocIn.next 覆盖到这里）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebSubmit",
        "next": [
            "TransferOrderWebNewBill"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebNewBill": {
        "desc": "填完一张后开下一张：点顶栏新增→顶部横幅点否放弃当前未保存单",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebNewBill",
        "custom_action_param": {
            "wait_label": "调出库存组织",
            "timeout_ms": 60000
        },
        "next": [
            "TransferOrderWebNextOrder"
        ],
        "on_error": [
            "TransferOrderWebStop"
        ]
    },
    "TransferOrderWebStop": {
        "desc": "异常停止节点：WebStop 返回 False 让任务真失败（DoNothing 会把失败伪装成完成）",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "action": "Custom",
        "custom_action": "WebStop"
    },
    "TransferOrderWebDone": {
        "desc": "直接调拨单(网页端)任务结束节点",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    }
}
