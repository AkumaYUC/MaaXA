{
    "TransferRequisitionFormEntry":{
        "desc":"调拨申请单任务入口",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormSetForm"
        ]
    },
    "TransferRequisitionFormSetForm":{
        "desc":"切换明细字段为动作白名单",
        "action":"Custom",
        "custom_action": "UiaSetForm",
        "custom_action_param": {
            "form":"requisition"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormReadExcel"
        ]
    },
    "TransferRequisitionFormReadExcel":{
        "desc":"读取调拨申请单Excel文件字段数据",
        "action": "Custom",
        "custom_action": "ReadTransferExcel",
        "custom_action_param": {
            "path":"",
            "template":"requisition"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormNavigate"
        ]
    },
    "TransferRequisitionFormNavigate":{
        "desc":"后台导航直达调拨申请单新增页签",
        "action":"Custom",
        "custom_action": "UiaNavigate",
        "custom_action_param": {
            "text":"调拨申请单",
            "wait_label":"申请组织",
            "timeout_ms":60000
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormNextOrder"
        ]
    },
    "TransferRequisitionFormNextOrder":{
        "desc":"调拨申请单下一张单的数据录入节点",
        "action": "Custom",
        "custom_action": "NextOrder",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormOrgs"
        ],
        "on_error": [
            "TransferRequisitionFormDone"
        ]
    },
    "TransferRequisitionFormOrgs":{
        "desc":"调出库存组织栏填写",
        "action": "Custom",
        "custom_action": "UiaFillColumn",
        "custom_action_param": {
            "field":"source_org",
            "broadcast":true
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFormOrgsIn"
        ]
    },
    "TransferRequisitionFormOrgsIn":{
        "desc":"调入库存组织栏填写",
        "action": "Custom",
        "custom_action": "UiaFillColumn",
        "custom_action_param": {
            "field":"target_org",
            "broadcast":true
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TransferRequisitionFillMaterial"
        ]
    },
    "TransferRequisitionFillMaterial":{
        "desc":"调拨申请单物料编码填写",
        "action": "Custom",
        "custom_action": "UiaSetCell",
        "custom_action_param": {
            "field":"material_code",
            "row":0
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },
    "TransferRequisitionFormDone":{
        "desc":"调拨申请单任务结束节点",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    }
}